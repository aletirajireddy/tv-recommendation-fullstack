# ─────────────────────────────────────────────────────────────────────────────
# strategy-lab configuration. Copy to ".env" and adjust.
#   cp .env.example .env   (mac/linux)
#   copy .env.example .env (windows)
# ─────────────────────────────────────────────────────────────────────────────

# Path to the LIVE trading database. Opened READ-ONLY — never written to.
# Default assumes strategy-lab/ sits next to dashboard_v3.db in the parent repo.
# When you move this folder elsewhere, point this at a COPY of the db to be 100% safe.
LIVE_DB_PATH=../dashboard_v3.db

# Where this lab stores its OWN data (archive + backtest results). Created if missing.
ARCHIVE_DB_PATH=./data/analytics_archive.db

# Archiver poll interval in seconds (loop mode). 120s aligns with Stream D buckets.
ARCHIVE_INTERVAL_SEC=120

# Comma-separated tables to mirror incrementally (high-water by `id`).
ARCHIVE_INCREMENTAL_TABLES=coin_metric_history,market_context_logs

# Comma-separated small tables to snapshot in full each run (INSERT OR REPLACE).
ARCHIVE_SNAPSHOT_TABLES=validation_trials,validation_state_log,pattern_statistics

# Master kill-switch. Must be "true" for the archiver to do anything.
# Off by default so an accidental run is a no-op.
ARCHIVE_ENABLED=false
